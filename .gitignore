# Ambiente virtual
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Banco de dados gerado pelo pipeline (reproduzivel via run_pipeline.py)
database/*.db

# Dados intermediarios gerados pelo pipeline
data/processed/*
!data/processed/.gitkeep

# Dataset original compactado (os CSVs extraidos estao versionados em data/raw/)
datasets/

# Figuras: os PNG sao versionados porque aparecem no README.
# O HTML interativo e' grande e nao renderiza no GitHub, entao fica de fora.
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/*.png

# Segredos e ambiente local
.env
*.key
secrets.*

# Sistema operacional / editores
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Especificacao do projeto (uso local, nao publicado)
CLAUDE.md

# Config local de editor
.claude/launch.json
